// The complete NMOS opcode matrix, including undocumented operations.
fn nes_decode(code: uint<8>) -> NesDecode {
    match code {
        0x00 => NesDecode { op: .BRK, mode: .Imp },
        0x01 => NesDecode { op: .ORA, mode: .Izx },
        0x02 => NesDecode { op: .KIL, mode: .Imp },
        0x03 => NesDecode { op: .SLO, mode: .Izx },
        0x04 => NesDecode { op: .NOP, mode: .Zp },
        0x05 => NesDecode { op: .ORA, mode: .Zp },
        0x06 => NesDecode { op: .ASL, mode: .Zp },
        0x07 => NesDecode { op: .SLO, mode: .Zp },
        0x08 => NesDecode { op: .PHP, mode: .Imp },
        0x09 => NesDecode { op: .ORA, mode: .Imm },
        0x0A => NesDecode { op: .ASL, mode: .Acc },
        0x0B => NesDecode { op: .ANC, mode: .Imm },
        0x0C => NesDecode { op: .NOP, mode: .Abs },
        0x0D => NesDecode { op: .ORA, mode: .Abs },
        0x0E => NesDecode { op: .ASL, mode: .Abs },
        0x0F => NesDecode { op: .SLO, mode: .Abs },
        0x10 => NesDecode { op: .BPL, mode: .Rel },
        0x11 => NesDecode { op: .ORA, mode: .Izy },
        0x12 => NesDecode { op: .KIL, mode: .Imp },
        0x13 => NesDecode { op: .SLO, mode: .Izy },
        0x14 => NesDecode { op: .NOP, mode: .Zpx },
        0x15 => NesDecode { op: .ORA, mode: .Zpx },
        0x16 => NesDecode { op: .ASL, mode: .Zpx },
        0x17 => NesDecode { op: .SLO, mode: .Zpx },
        0x18 => NesDecode { op: .CLC, mode: .Imp },
        0x19 => NesDecode { op: .ORA, mode: .Aby },
        0x1A => NesDecode { op: .NOP, mode: .Imp },
        0x1B => NesDecode { op: .SLO, mode: .Aby },
        0x1C => NesDecode { op: .NOP, mode: .Abx },
        0x1D => NesDecode { op: .ORA, mode: .Abx },
        0x1E => NesDecode { op: .ASL, mode: .Abx },
        0x1F => NesDecode { op: .SLO, mode: .Abx },
        0x20 => NesDecode { op: .JSR, mode: .Abs },
        0x21 => NesDecode { op: .AND, mode: .Izx },
        0x22 => NesDecode { op: .KIL, mode: .Imp },
        0x23 => NesDecode { op: .RLA, mode: .Izx },
        0x24 => NesDecode { op: .BIT, mode: .Zp },
        0x25 => NesDecode { op: .AND, mode: .Zp },
        0x26 => NesDecode { op: .ROL, mode: .Zp },
        0x27 => NesDecode { op: .RLA, mode: .Zp },
        0x28 => NesDecode { op: .PLP, mode: .Imp },
        0x29 => NesDecode { op: .AND, mode: .Imm },
        0x2A => NesDecode { op: .ROL, mode: .Acc },
        0x2B => NesDecode { op: .ANC, mode: .Imm },
        0x2C => NesDecode { op: .BIT, mode: .Abs },
        0x2D => NesDecode { op: .AND, mode: .Abs },
        0x2E => NesDecode { op: .ROL, mode: .Abs },
        0x2F => NesDecode { op: .RLA, mode: .Abs },
        0x30 => NesDecode { op: .BMI, mode: .Rel },
        0x31 => NesDecode { op: .AND, mode: .Izy },
        0x32 => NesDecode { op: .KIL, mode: .Imp },
        0x33 => NesDecode { op: .RLA, mode: .Izy },
        0x34 => NesDecode { op: .NOP, mode: .Zpx },
        0x35 => NesDecode { op: .AND, mode: .Zpx },
        0x36 => NesDecode { op: .ROL, mode: .Zpx },
        0x37 => NesDecode { op: .RLA, mode: .Zpx },
        0x38 => NesDecode { op: .SEC, mode: .Imp },
        0x39 => NesDecode { op: .AND, mode: .Aby },
        0x3A => NesDecode { op: .NOP, mode: .Imp },
        0x3B => NesDecode { op: .RLA, mode: .Aby },
        0x3C => NesDecode { op: .NOP, mode: .Abx },
        0x3D => NesDecode { op: .AND, mode: .Abx },
        0x3E => NesDecode { op: .ROL, mode: .Abx },
        0x3F => NesDecode { op: .RLA, mode: .Abx },
        0x40 => NesDecode { op: .RTI, mode: .Imp },
        0x41 => NesDecode { op: .EOR, mode: .Izx },
        0x42 => NesDecode { op: .KIL, mode: .Imp },
        0x43 => NesDecode { op: .SRE, mode: .Izx },
        0x44 => NesDecode { op: .NOP, mode: .Zp },
        0x45 => NesDecode { op: .EOR, mode: .Zp },
        0x46 => NesDecode { op: .LSR, mode: .Zp },
        0x47 => NesDecode { op: .SRE, mode: .Zp },
        0x48 => NesDecode { op: .PHA, mode: .Imp },
        0x49 => NesDecode { op: .EOR, mode: .Imm },
        0x4A => NesDecode { op: .LSR, mode: .Acc },
        0x4B => NesDecode { op: .ALR, mode: .Imm },
        0x4C => NesDecode { op: .JMP, mode: .Abs },
        0x4D => NesDecode { op: .EOR, mode: .Abs },
        0x4E => NesDecode { op: .LSR, mode: .Abs },
        0x4F => NesDecode { op: .SRE, mode: .Abs },
        0x50 => NesDecode { op: .BVC, mode: .Rel },
        0x51 => NesDecode { op: .EOR, mode: .Izy },
        0x52 => NesDecode { op: .KIL, mode: .Imp },
        0x53 => NesDecode { op: .SRE, mode: .Izy },
        0x54 => NesDecode { op: .NOP, mode: .Zpx },
        0x55 => NesDecode { op: .EOR, mode: .Zpx },
        0x56 => NesDecode { op: .LSR, mode: .Zpx },
        0x57 => NesDecode { op: .SRE, mode: .Zpx },
        0x58 => NesDecode { op: .CLI, mode: .Imp },
        0x59 => NesDecode { op: .EOR, mode: .Aby },
        0x5A => NesDecode { op: .NOP, mode: .Imp },
        0x5B => NesDecode { op: .SRE, mode: .Aby },
        0x5C => NesDecode { op: .NOP, mode: .Abx },
        0x5D => NesDecode { op: .EOR, mode: .Abx },
        0x5E => NesDecode { op: .LSR, mode: .Abx },
        0x5F => NesDecode { op: .SRE, mode: .Abx },
        0x60 => NesDecode { op: .RTS, mode: .Imp },
        0x61 => NesDecode { op: .ADC, mode: .Izx },
        0x62 => NesDecode { op: .KIL, mode: .Imp },
        0x63 => NesDecode { op: .RRA, mode: .Izx },
        0x64 => NesDecode { op: .NOP, mode: .Zp },
        0x65 => NesDecode { op: .ADC, mode: .Zp },
        0x66 => NesDecode { op: .ROR, mode: .Zp },
        0x67 => NesDecode { op: .RRA, mode: .Zp },
        0x68 => NesDecode { op: .PLA, mode: .Imp },
        0x69 => NesDecode { op: .ADC, mode: .Imm },
        0x6A => NesDecode { op: .ROR, mode: .Acc },
        0x6B => NesDecode { op: .ARR, mode: .Imm },
        0x6C => NesDecode { op: .JMP, mode: .Ind },
        0x6D => NesDecode { op: .ADC, mode: .Abs },
        0x6E => NesDecode { op: .ROR, mode: .Abs },
        0x6F => NesDecode { op: .RRA, mode: .Abs },
        0x70 => NesDecode { op: .BVS, mode: .Rel },
        0x71 => NesDecode { op: .ADC, mode: .Izy },
        0x72 => NesDecode { op: .KIL, mode: .Imp },
        0x73 => NesDecode { op: .RRA, mode: .Izy },
        0x74 => NesDecode { op: .NOP, mode: .Zpx },
        0x75 => NesDecode { op: .ADC, mode: .Zpx },
        0x76 => NesDecode { op: .ROR, mode: .Zpx },
        0x77 => NesDecode { op: .RRA, mode: .Zpx },
        0x78 => NesDecode { op: .SEI, mode: .Imp },
        0x79 => NesDecode { op: .ADC, mode: .Aby },
        0x7A => NesDecode { op: .NOP, mode: .Imp },
        0x7B => NesDecode { op: .RRA, mode: .Aby },
        0x7C => NesDecode { op: .NOP, mode: .Abx },
        0x7D => NesDecode { op: .ADC, mode: .Abx },
        0x7E => NesDecode { op: .ROR, mode: .Abx },
        0x7F => NesDecode { op: .RRA, mode: .Abx },
        0x80 => NesDecode { op: .NOP, mode: .Imm },
        0x81 => NesDecode { op: .STA, mode: .Izx },
        0x82 => NesDecode { op: .NOP, mode: .Imm },
        0x83 => NesDecode { op: .SAX, mode: .Izx },
        0x84 => NesDecode { op: .STY, mode: .Zp },
        0x85 => NesDecode { op: .STA, mode: .Zp },
        0x86 => NesDecode { op: .STX, mode: .Zp },
        0x87 => NesDecode { op: .SAX, mode: .Zp },
        0x88 => NesDecode { op: .DEY, mode: .Imp },
        0x89 => NesDecode { op: .NOP, mode: .Imm },
        0x8A => NesDecode { op: .TXA, mode: .Imp },
        0x8B => NesDecode { op: .XAA, mode: .Imm },
        0x8C => NesDecode { op: .STY, mode: .Abs },
        0x8D => NesDecode { op: .STA, mode: .Abs },
        0x8E => NesDecode { op: .STX, mode: .Abs },
        0x8F => NesDecode { op: .SAX, mode: .Abs },
        0x90 => NesDecode { op: .BCC, mode: .Rel },
        0x91 => NesDecode { op: .STA, mode: .Izy },
        0x92 => NesDecode { op: .KIL, mode: .Imp },
        0x93 => NesDecode { op: .AHX, mode: .Izy },
        0x94 => NesDecode { op: .STY, mode: .Zpx },
        0x95 => NesDecode { op: .STA, mode: .Zpx },
        0x96 => NesDecode { op: .STX, mode: .Zpy },
        0x97 => NesDecode { op: .SAX, mode: .Zpy },
        0x98 => NesDecode { op: .TYA, mode: .Imp },
        0x99 => NesDecode { op: .STA, mode: .Aby },
        0x9A => NesDecode { op: .TXS, mode: .Imp },
        0x9B => NesDecode { op: .TAS, mode: .Aby },
        0x9C => NesDecode { op: .SHY, mode: .Abx },
        0x9D => NesDecode { op: .STA, mode: .Abx },
        0x9E => NesDecode { op: .SHX, mode: .Aby },
        0x9F => NesDecode { op: .AHX, mode: .Aby },
        0xA0 => NesDecode { op: .LDY, mode: .Imm },
        0xA1 => NesDecode { op: .LDA, mode: .Izx },
        0xA2 => NesDecode { op: .LDX, mode: .Imm },
        0xA3 => NesDecode { op: .LAX, mode: .Izx },
        0xA4 => NesDecode { op: .LDY, mode: .Zp },
        0xA5 => NesDecode { op: .LDA, mode: .Zp },
        0xA6 => NesDecode { op: .LDX, mode: .Zp },
        0xA7 => NesDecode { op: .LAX, mode: .Zp },
        0xA8 => NesDecode { op: .TAY, mode: .Imp },
        0xA9 => NesDecode { op: .LDA, mode: .Imm },
        0xAA => NesDecode { op: .TAX, mode: .Imp },
        0xAB => NesDecode { op: .LAX, mode: .Imm },
        0xAC => NesDecode { op: .LDY, mode: .Abs },
        0xAD => NesDecode { op: .LDA, mode: .Abs },
        0xAE => NesDecode { op: .LDX, mode: .Abs },
        0xAF => NesDecode { op: .LAX, mode: .Abs },
        0xB0 => NesDecode { op: .BCS, mode: .Rel },
        0xB1 => NesDecode { op: .LDA, mode: .Izy },
        0xB2 => NesDecode { op: .KIL, mode: .Imp },
        0xB3 => NesDecode { op: .LAX, mode: .Izy },
        0xB4 => NesDecode { op: .LDY, mode: .Zpx },
        0xB5 => NesDecode { op: .LDA, mode: .Zpx },
        0xB6 => NesDecode { op: .LDX, mode: .Zpy },
        0xB7 => NesDecode { op: .LAX, mode: .Zpy },
        0xB8 => NesDecode { op: .CLV, mode: .Imp },
        0xB9 => NesDecode { op: .LDA, mode: .Aby },
        0xBA => NesDecode { op: .TSX, mode: .Imp },
        0xBB => NesDecode { op: .LAS, mode: .Aby },
        0xBC => NesDecode { op: .LDY, mode: .Abx },
        0xBD => NesDecode { op: .LDA, mode: .Abx },
        0xBE => NesDecode { op: .LDX, mode: .Aby },
        0xBF => NesDecode { op: .LAX, mode: .Aby },
        0xC0 => NesDecode { op: .CPY, mode: .Imm },
        0xC1 => NesDecode { op: .CMP, mode: .Izx },
        0xC2 => NesDecode { op: .NOP, mode: .Imm },
        0xC3 => NesDecode { op: .DCP, mode: .Izx },
        0xC4 => NesDecode { op: .CPY, mode: .Zp },
        0xC5 => NesDecode { op: .CMP, mode: .Zp },
        0xC6 => NesDecode { op: .DEC, mode: .Zp },
        0xC7 => NesDecode { op: .DCP, mode: .Zp },
        0xC8 => NesDecode { op: .INY, mode: .Imp },
        0xC9 => NesDecode { op: .CMP, mode: .Imm },
        0xCA => NesDecode { op: .DEX, mode: .Imp },
        0xCB => NesDecode { op: .AXS, mode: .Imm },
        0xCC => NesDecode { op: .CPY, mode: .Abs },
        0xCD => NesDecode { op: .CMP, mode: .Abs },
        0xCE => NesDecode { op: .DEC, mode: .Abs },
        0xCF => NesDecode { op: .DCP, mode: .Abs },
        0xD0 => NesDecode { op: .BNE, mode: .Rel },
        0xD1 => NesDecode { op: .CMP, mode: .Izy },
        0xD2 => NesDecode { op: .KIL, mode: .Imp },
        0xD3 => NesDecode { op: .DCP, mode: .Izy },
        0xD4 => NesDecode { op: .NOP, mode: .Zpx },
        0xD5 => NesDecode { op: .CMP, mode: .Zpx },
        0xD6 => NesDecode { op: .DEC, mode: .Zpx },
        0xD7 => NesDecode { op: .DCP, mode: .Zpx },
        0xD8 => NesDecode { op: .CLD, mode: .Imp },
        0xD9 => NesDecode { op: .CMP, mode: .Aby },
        0xDA => NesDecode { op: .NOP, mode: .Imp },
        0xDB => NesDecode { op: .DCP, mode: .Aby },
        0xDC => NesDecode { op: .NOP, mode: .Abx },
        0xDD => NesDecode { op: .CMP, mode: .Abx },
        0xDE => NesDecode { op: .DEC, mode: .Abx },
        0xDF => NesDecode { op: .DCP, mode: .Abx },
        0xE0 => NesDecode { op: .CPX, mode: .Imm },
        0xE1 => NesDecode { op: .SBC, mode: .Izx },
        0xE2 => NesDecode { op: .NOP, mode: .Imm },
        0xE3 => NesDecode { op: .ISC, mode: .Izx },
        0xE4 => NesDecode { op: .CPX, mode: .Zp },
        0xE5 => NesDecode { op: .SBC, mode: .Zp },
        0xE6 => NesDecode { op: .INC, mode: .Zp },
        0xE7 => NesDecode { op: .ISC, mode: .Zp },
        0xE8 => NesDecode { op: .INX, mode: .Imp },
        0xE9 => NesDecode { op: .SBC, mode: .Imm },
        0xEA => NesDecode { op: .NOP, mode: .Imp },
        0xEB => NesDecode { op: .SBC, mode: .Imm },
        0xEC => NesDecode { op: .CPX, mode: .Abs },
        0xED => NesDecode { op: .SBC, mode: .Abs },
        0xEE => NesDecode { op: .INC, mode: .Abs },
        0xEF => NesDecode { op: .ISC, mode: .Abs },
        0xF0 => NesDecode { op: .BEQ, mode: .Rel },
        0xF1 => NesDecode { op: .SBC, mode: .Izy },
        0xF2 => NesDecode { op: .KIL, mode: .Imp },
        0xF3 => NesDecode { op: .ISC, mode: .Izy },
        0xF4 => NesDecode { op: .NOP, mode: .Zpx },
        0xF5 => NesDecode { op: .SBC, mode: .Zpx },
        0xF6 => NesDecode { op: .INC, mode: .Zpx },
        0xF7 => NesDecode { op: .ISC, mode: .Zpx },
        0xF8 => NesDecode { op: .SED, mode: .Imp },
        0xF9 => NesDecode { op: .SBC, mode: .Aby },
        0xFA => NesDecode { op: .NOP, mode: .Imp },
        0xFB => NesDecode { op: .ISC, mode: .Aby },
        0xFC => NesDecode { op: .NOP, mode: .Abx },
        0xFD => NesDecode { op: .SBC, mode: .Abx },
        0xFE => NesDecode { op: .INC, mode: .Abx },
