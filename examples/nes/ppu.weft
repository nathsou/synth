// SPDX-License-Identifier: CERN-OHL-W-2.0
// NTSC RP2C02 digital picture generator. Clock at one edge per PPU dot.
// Palette RAM contents at power-up are unspecified and differ between chips;
// these are the values blargg recorded on one NES, used here for determinism.
const NES_POWER_UP_PALETTE: [uint<8>; 32] = [
    0x09,0x01,0x00,0x01,0x00,0x02,0x02,0x0D,0x08,0x10,0x08,0x24,0x00,0x00,0x04,0x2C,
    0x09,0x01,0x34,0x03,0x00,0x04,0x00,0x14,0x08,0x3A,0x00,0x02,0x00,0x20,0x2C,0x08,
];
fn nes_palette_index(address: uint<5>) -> uint<5> {
    if address[1:0] == 0 { address & 0x0F } else { address }
}
fn nes_nametable_index(address: uint<14>, mirroring: uint<3>) -> uint<12> {
    let page: uint<2> = match mirroring {
        0 => 0, 1 => 1, 2 => uint<2>(address[10].bits()),
        3 => uint<2>(address[11].bits()), _ => address[11:10],
    };
    concat(page, address[9:0])
}
fn nes_scroll_x(v: uint<15>) -> uint<15> {
    if v[4:0] == 31 { (v & 0x7FE0) ^ 0x0400 } else { v +% 1 }
}
fn nes_scroll_y(v: uint<15>) -> uint<15> {
    var r: uint<15> = v;
    if v[14:12] != 7 { r = v +% 0x1000; }
    else {
        r = v & 0x0FFF;
        if v[9:5] == 29 { r = (r & 0x7C1F) ^ 0x0800; }
        else if v[9:5] == 31 { r = r & 0x7C1F; }
        else { r = r +% 0x20; }
    }
    r
}

module nes_ppu(
    in cpu_access: bool, in cpu_write: bool, in cpu_register: uint<3>, in cpu_data: uint<8>,
    in mirroring: uint<3>, in chr_data: uint<8>,
    out cpu_read: uint<8>, out nmi: bool,
    out memory_address: uint<14>, out chr_write: bool, out chr_write_data: uint<8>,
    out pixel: uint<6>, out emphasis: uint<3>, out pixel_valid: bool,
    out pixel_x: uint<8>, out pixel_y: uint<8>, out frame: bool,
    out debug_dot: uint<9>, out debug_line: uint<9>,
) {
    reg dot: index<341> = 0;
    reg line: index<262> = 0;
    reg odd: bool = false;
    reg skipped_idle: bool = false;
    reg warming_up: bool = true;
    reg ctrl: uint<8> = 0;
    reg mask: uint<8> = 0;
    reg v: uint<15> = 0;
    reg t: uint<15> = 0;
    reg fine_x: uint<3> = 0;
    reg second_write: bool = false;
    reg vblank: bool = false;
    reg sprite_hit: bool = false;
    reg overflow: bool = false;
    reg suppress_vblank: bool = false;
    reg nmi_delay: uint<2> = 0;
    reg io_latch: uint<8> = 0;
    // A deterministic approximation of the PPU's dynamic bus charge: a
    // refreshed bit decays after three ticks of a shared 200 ms timer, 400 to
    // 600 ms later. Actual decay varies among chips and with temperature.
    reg decay_timer: uint<21> = 0;
    reg io_decay: [uint<2>; 8] = [0; 8];
    reg read_buffer: uint<8> = 0;
    reg last_read: uint<8> = 0;
    reg read_cooldown: uint<3> = 0;
    if read_cooldown != 0 { read_cooldown := read_cooldown -% 1; }
    reg oam_address: uint<8> = 0;
    // Block RAM reads are registered on the falling edge: addresses come
    // from registers, so data is ready half a dot later, within the cycle.
    domain half { clock: default.clock, edge: falling }
    mem oam: [uint<8>; 256] @default;
    mem vram: [uint<8>; 4096] @default;
    reg oam_q: uint<8> @half init 0;
    reg vram_q: uint<8> @half init 0;
    // Entries are 6 bits; storing 8 lets the palette use block RAM (one copy
    // per read port: rendering and $2007).
    mem palette: [uint<8>; 32] @default init NES_POWER_UP_PALETTE;
    reg palette_cpu_q: uint<8> @half init 0;
    reg palette_pixel_q: uint<8> @half init 0;
    // Secondary OAM is read one byte per dot while sprites are fetched
    // (Y, tile, attributes, X), as in the PPU, so it fits a block RAM.
    mem secondary: [uint<8>; 32] @default init [0xFF; 32];
    reg secondary_q: uint<8> @half init 0xFF;
    reg fetch_y: uint<8> = 0xFF;
    reg fetch_tile: uint<8> = 0xFF;
    reg fetch_attr: uint<8> = 0xFF;
    reg secondary_zero: [bool; 8] = [false; 8];
    reg eval_n: uint<6> = 0;
    reg eval_m: uint<2> = 0;
    reg eval_count: uint<4> = 0;
    reg eval_data: uint<8> = 0xFF;
    reg eval_done: bool = false;
    reg sprite_low: [uint<8>; 8] = [0; 8];
    reg sprite_high: [uint<8>; 8] = [0; 8];
    reg sprite_x: [uint<8>; 8] = [0xFF; 8];
    reg sprite_attr: [uint<8>; 8] = [0; 8];
    reg sprite_zero: [bool; 8] = [false; 8];
    reg sprite_active: [bool; 8] = [false; 8];
    reg sprite_fetch_low: uint<8> = 0;
    reg name_latch: uint<8> = 0;
    reg attr_latch: uint<2> = 0;
    reg low_latch: uint<8> = 0;
    reg bg_low: uint<16> = 0;
    reg bg_high: uint<16> = 0;
    reg attr_low: uint<16> = 0;
    reg attr_high: uint<16> = 0;

    let decay_tick = decay_timer == 0;
    decay_timer := if decay_tick { 1_073_863 } else { decay_timer -% 1 };
    for i in 0..8 {
        if decay_tick && io_decay[i] != 0 {
            io_decay[i] := io_decay[i] -% 1;
            if io_decay[i] == 1 { io_latch[i] := false; }
        }
    }

    let rendering = mask[3] || mask[4];
    let render_line = line < 240 || line == 261;
    let fetching = rendering && render_line;
    let bg_fetch = (dot >= 1 && dot <= 256) || (dot >= 321 && dot <= 336);
    let sprite_fetch = dot >= 257 && dot <= 320;
    let phase: uint<3> = uint<9>(dot)[2:0];
    let sprite_slot: uint<3> = (uint<9>(dot) -% 257)[5:3];
    secondary_q := secondary[concat(sprite_slot, (phase -% 1)[1:0])];
    // One write port: clearing on dots 1-64, then copies during evaluation.
    wire secondary_write: bool;
    wire secondary_address: uint<5>;
    wire secondary_data: uint<8>;
    secondary_write = false; secondary_address = (uint<9>(dot) -% 1)[5:1]; secondary_data = 0xFF;
    let tile = fetch_tile;
    let attr = fetch_attr;
    let sprite_row = uint<9>(line)[7:0] -% fetch_y;
    let flipped_row = sprite_row ^ (if attr[7] { uint<8>(if ctrl[5] { 15 } else { 7 }) } else { uint<8>(0) });
    let sprite_pattern: uint<13> = if ctrl[5] {
        concat(tile[0], tile[7:1], flipped_row[3], false, flipped_row[2:0])
    } else { concat(ctrl[3], tile, false, flipped_row[2:0]) };
    let bg_pattern: uint<14> = concat(false, ctrl[4], name_latch, false, v[14:12]);
    let name_address: uint<14> = concat(0b10, v[11:0]);
    let attr_address: uint<14> = concat(0b10, v[11:10], 0b1111, v[9:7], v[4:2]);
    wire fetch_address: uint<14>;
    fetch_address = v[13:0];
    if fetching {
        fetch_address = name_address;
        // The visible-line idle dot begins an aborted low-pattern fetch.
        // After an odd-frame skip it instead completes the dummy NT fetch.
        if dot == 0 && line < 240 && !skipped_idle { fetch_address = bg_pattern; }
        if bg_fetch {
            fetch_address = match phase {
                1 | 2 => name_address, 3 | 4 => attr_address,
                5 | 6 => bg_pattern, 7 | 0 => bg_pattern | 8,
            };
        } else if sprite_fetch {
            if phase == 5 || phase == 6 { fetch_address = uint<14>(sprite_pattern); }
            if phase == 7 || phase == 0 { fetch_address = uint<14>(sprite_pattern) | 8; }
        }
    }
    let data_access = cpu_access && cpu_register == 7;
    // Palette reads also fill the buffer from the nametable under the palette.
    memory_address = if data_access { v[13:0] & (if !cpu_write && v[13:8] == 0x3F { uint<14>(0x2FFF) } else { uint<14>(0x3FFF) }) }
                     else { fetch_address };
    let nt_index = nes_nametable_index(memory_address, mirroring);
    vram_q := vram[nt_index];
    let bus_data = if memory_address[13] { vram_q } else { chr_data };
    chr_write = data_access && cpu_write && v[13:0] < 0x2000;
    chr_write_data = cpu_data;
    let pal_index = nes_palette_index(v[4:0]);
    palette_cpu_q := palette[pal_index];
    let palette_read: uint<8> = (io_latch & 0xC0) | (palette_cpu_q & (if mask[0] { uint<8>(0x30) } else { uint<8>(0x3F) }));
    let status = concat(vblank, sprite_hit, overflow, io_latch[4:0]);
    // One OAM read port: sprite evaluation on odd dots, otherwise $2004.
    let oam_eval = fetching && dot >= 65 && dot <= 256 && !eval_done && line < 240 && phase[0];
    oam_q := oam[if oam_eval { concat(eval_n, eval_m) } else { oam_address }];
    let oam_read = if fetching { if dot <= 64 { uint<8>(0xFF) } else { eval_data } }
                   else { oam_q };
    cpu_read = match cpu_register {
        2 => status,
        4 => if oam_address[1:0] == 2 { oam_read & 0xE3 } else { oam_read },
        7 => if v[13:8] == 0x3F { palette_read }
             else if read_cooldown != 0 { last_read } else { read_buffer },
        _ => io_latch,
    };
    // Delay the PPU's NMI output; a coincident status read cancels the pulse
    // before the CPU edge detector can latch it.
    nmi_delay := concat(nmi_delay[0], vblank);
    nmi = nmi_delay[0] && vblank && ctrl[7]
          && !(cpu_access && !cpu_write && cpu_register == 2)
          && !(cpu_access && cpu_write && cpu_register == 0 && !cpu_data[7]);

    // Priority is the first opaque sprite in OAM order, even behind background.
    wire chosen: bool;
    wire sp_bits: uint<2>;
    wire sp_palette: uint<2>;
    wire sp_behind: bool;
    wire sp_zero: bool;
    chosen = false; sp_bits = 0; sp_palette = 0; sp_behind = false; sp_zero = false;
    for i in 0..8 {
        const J = 7 - i;
        let bits = concat(sprite_high[J][7], sprite_low[J][7]);
        if sprite_active[J] && sprite_x[J] == 0 && bits != 0 {
            chosen = true; sp_bits = bits; sp_palette = sprite_attr[J][1:0];
            sp_behind = sprite_attr[J][5]; sp_zero = sprite_zero[J];
        }
    }
    let bit_pos: uint<4> = 15 - fine_x;
    let bg_bits: uint<2> = if mask[3] && (dot > 8 || mask[1]) { concat(bg_high[bit_pos], bg_low[bit_pos]) } else { 0 };
    let bg_pal = concat(attr_high[bit_pos], attr_low[bit_pos]);
    let sp_visible = chosen && mask[4] && (dot > 8 || mask[2]);
    let use_sprite = sp_visible && (bg_bits == 0 || !sp_behind);
    let output_index: uint<5> = if use_sprite { concat(true, sp_palette, sp_bits) }
                              else if bg_bits != 0 { concat(false, bg_pal, bg_bits) } else { 0 };
    let forced_index = if !rendering && v[13:8] == 0x3F { pal_index } else { output_index };
    palette_pixel_q := palette[nes_palette_index(forced_index)];
    pixel = palette_pixel_q[5:0] & (if mask[0] { uint<6>(0x30) } else { uint<6>(0x3F) });
    emphasis = mask[7:5];
    pixel_valid = line < 240 && dot >= 1 && dot <= 256;
    pixel_x = (uint<9>(dot) -% 1)[7:0]; pixel_y = uint<9>(line)[7:0];
    frame = line == 241 && dot == 1;
    debug_dot = dot; debug_line = line;

    dot := dot +% 1;
    if dot == 0 { skipped_idle := false; }
    if dot == 340 { line := line +% 1; if line == 261 { odd := !odd; } }
    if line == 261 && dot == 339 && odd && rendering { dot := 0; line := 0; odd := !odd; skipped_idle := true; }
    if line == 241 && dot == 1 { vblank := !suppress_vblank; suppress_vblank := false; }
    if line == 261 && dot == 1 {
        vblank := false; sprite_hit := false; overflow := false;
        suppress_vblank := false; warming_up := false;
    }

    if pixel_valid && bg_bits != 0 && sp_visible && sp_zero && dot != 256 { sprite_hit := true; }
    if fetching {
        if bg_fetch {
            bg_low := bg_low << 1; bg_high := bg_high << 1;
            attr_low := attr_low << 1; attr_high := attr_high << 1;
            match phase {
                2 => { name_latch := bus_data; }
                4 => { attr_latch := (bus_data >> concat(v[6], v[1], false))[1:0]; }
                6 => { low_latch := bus_data; }
                0 => {
                    bg_low := concat(bg_low[14:7], low_latch);
                    bg_high := concat(bg_high[14:7], bus_data);
                    attr_low := concat(attr_low[14:7], attr_latch[0].bits().replicate(8));
                    attr_high := concat(attr_high[14:7], attr_latch[1].bits().replicate(8));
                    v := nes_scroll_x(v);
                }
                _ => {}
            }
        }
        if dot == 256 { v := nes_scroll_y(nes_scroll_x(v)); }
        if dot == 257 { v := (v & 0x7BE0) | (t & 0x041F); }
        if line == 261 && dot >= 280 && dot <= 304 { v := (v & 0x041F) | (t & 0x7BE0); }
        if dot >= 1 && dot <= 256 {
            for i in 0..8 {
                if sprite_x[i] != 0 { sprite_x[i] := sprite_x[i] -% 1; }
                else { sprite_low[i] := sprite_low[i] << 1; sprite_high[i] := sprite_high[i] << 1; }
            }
        }
        if dot == 1 { eval_n := 0; eval_m := 0; eval_count := 0; eval_done := false; secondary_zero := [false; 8]; }
        if dot >= 1 && dot <= 64 && !phase[0] { secondary_write = true; }
        if dot >= 65 && dot <= 256 && !eval_done && line < 240 {
            if phase[0] { eval_data := oam_q; }
            else {
                let row = uint<9>(line) -% uint<9>(eval_data);
                let in_range = row < (if ctrl[5] { 16 } else { 8 });
                if eval_count < 8 {
                    if eval_m != 0 || in_range {
                        secondary_write = true; secondary_address = concat(eval_count[2:0], eval_m);
                        secondary_data = eval_data;
                        if eval_m == 0 { secondary_zero[eval_count[2:0]] := eval_n == 0; }
                        eval_m := eval_m +% 1;
                        if eval_m == 3 { eval_count := eval_count +% 1; eval_n := eval_n +% 1; if eval_n == 63 { eval_done := true; } }
                    } else { eval_n := eval_n +% 1; if eval_n == 63 { eval_done := true; } }
                } else {
                    if in_range { overflow := true; }
                    eval_n := eval_n +% 1; eval_m := eval_m +% 1;
                    if eval_n == 63 { eval_done := true; }
                }
            }
        }
        if sprite_fetch {
            oam_address := 0;
            match phase {
                1 => {
                    fetch_y := secondary_q;
                    sprite_zero[sprite_slot] := secondary_zero[sprite_slot];
                    sprite_active[sprite_slot] := uint<4>(sprite_slot) < eval_count;
                }
                2 => { fetch_tile := secondary_q; }
                3 => { fetch_attr := secondary_q; sprite_attr[sprite_slot] := secondary_q; }
                4 => { sprite_x[sprite_slot] := secondary_q; }
                _ => {}
            }
            if phase == 6 { sprite_fetch_low := if attr[6] { bus_data.reverse() } else { bus_data }; }
            if phase == 0 {
                sprite_low[sprite_slot] := sprite_fetch_low;
                sprite_high[sprite_slot] := if attr[6] { bus_data.reverse() } else { bus_data };
            }
        }
    }

    if secondary_write { secondary[secondary_address] := secondary_data; }

    if cpu_access {
        if cpu_write {
            io_latch := cpu_data;
            io_decay := [3; 8];
            match cpu_register {
                0 => if !warming_up { ctrl := cpu_data; t := (t & 0x73FF) | (uint<15>(cpu_data[1:0]) << 10); }
                1 => if !warming_up { mask := cpu_data; }
                3 => { oam_address := cpu_data; }
                4 => {
                    if !fetching {
                        oam[oam_address] := if oam_address[1:0] == 2 { cpu_data & 0xE3 } else { cpu_data };
                        oam_address := oam_address +% 1;
                    } else { oam_address := oam_address +% 4; }
                }
                5 => if !warming_up {
                    second_write := !second_write;
                    if !second_write { t := (t & 0x7FE0) | uint<15>(cpu_data[7:3]); fine_x := cpu_data[2:0]; }
                    else { t := (t & 0x0C1F) | (uint<15>(cpu_data[7:3]) << 5) | (uint<15>(cpu_data[2:0]) << 12); }
                }
                6 => if !warming_up {
                    second_write := !second_write;
                    if !second_write { t := (t & 0x00FF) | (uint<15>(cpu_data[5:0]) << 8); }
                    else { t := (t & 0x7F00) | uint<15>(cpu_data); v := (t & 0x7F00) | uint<15>(cpu_data); }
                }
                7 => {
                    if v[13:8] == 0x3F { palette[pal_index] := cpu_data & 0x3F; }
                    else if v[13] { vram[nt_index] := cpu_data; }
                }
                _ => {}
            }
        } else {
            if cpu_register == 2 {
                io_latch := status; vblank := false; second_write := false;
                for i in 5..8 { io_decay[i] := 3; }
                if line == 241 && dot == 1 { suppress_vblank := true; }
            }
            if cpu_register == 4 { io_latch := cpu_read; io_decay := [3; 8]; }
            if cpu_register == 7 {
                io_latch := cpu_read; read_buffer := bus_data;
                last_read := cpu_read; read_cooldown := 5;
                for i in 0..6 { io_decay[i] := 3; }
                if v[13:8] != 0x3F { io_decay[6] := 3; io_decay[7] := 3; }
            }
        }
        if cpu_register == 7 {
            v := if fetching { nes_scroll_y(nes_scroll_x(v)) } else { v +% (if ctrl[2] { 32 } else { 1 }) };
        }
    }
}
