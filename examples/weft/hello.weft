// SPDX-License-Identifier: CERN-OHL-W-2.0
// Prints a greeting over the Go Board's USB UART (115200 8N1) once a second.
// Build with uart.weft.

const MESSAGE: [uint<8>; 14] = [
    0x48, 0x65, 0x6C, 0x6C, 0x6F, 0x2C, 0x20, // "Hello, "
    0x57, 0x65, 0x66, 0x74, 0x21,             // "Weft!"
    0x0D, 0x0A,                               // "\r\n"
];

/// CLK_HZ: the clock frequency (25 MHz on the Go Board). PERIOD (a second)
/// and CLKS_PER_BIT (115200 baud) are in clock cycles.
module top<CLK_HZ: int = 25_000_000, PERIOD: int = CLK_HZ, CLKS_PER_BIT: int = CLK_HZ / 115200>(in clk: clock, out tx: bool, out led: uint<4>) {
    inst second = divider<PERIOD>();
    inst uart = uart_tx<CLKS_PER_BIT>();

    reg sending: bool = false;
    reg pos: index<14> = 0;

    // Start a character whenever the transmitter is free.
    uart.start = sending && !uart.busy;
    uart.byte = MESSAGE[pos];
    if second.tick { sending := true; }
    if sending && !uart.busy {
        pos := pos +% 1;
        if pos == 13 { sending := false; }
    }

    tx = uart.tx;
    led = concat(uart.busy, 0b000);
}
