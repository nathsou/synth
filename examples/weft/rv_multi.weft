// SPDX-License-Identifier: CERN-OHL-W-2.0
// A multi-cycle RV32I core: each instruction takes five cycles, one per step
// (fetch, decode, execute, memory, write back), so every memory can be a block
// RAM and each step has a cycle of its own. It runs rv_program.weft, which
// prints over the UART (115200 8N1). Build with rv32i.weft, rv_program.weft
// and uart.weft.

enum Step { Fetch, Decode, Execute, Memory, WriteBack }

/// CLK_HZ: the board's clock frequency. MAX_HZ: the fastest clock the core
/// meets timing at on every board (the Alchitry Cu's iCE40 being the
/// slowest); it runs at SYS_HZ, the slower of the two, from the board's PLL.
/// CLKS_PER_BIT: for 115200 baud. DELAY: the pause between two runs of the
/// program (see rv_program.weft).
module top<
    CLK_HZ: int = 12_000_000,
    MAX_HZ: int = 40_000_000,
    SYS_HZ: int = min(CLK_HZ, MAX_HZ),
    CLKS_PER_BIT: int = SYS_HZ / 115200,
    DELAY: int = 200,
>(
    in  clk: clock,
    out tx: bool,
    out led: uint<8>,
) {
    // The core's clock, from the PLL (or the board's clock itself, if not
    // faster), and its reset until the PLL locks.
    inst pll = synth_pll<IN_HZ: CLK_HZ, OUT_HZ: SYS_HZ>(clk_in: clk);
    domain raw { clock: pll.clk_out }
    let rst = reset_sync(!pll.locked) @raw;
    default domain sys { clock: pll.clk_out, reset: rst }

    mem rom: [uint<32>; 128] init program<128>(DELAY);
    mem regs1: [uint<32>; 32]; // two copies of the register file, one per read port
    mem regs2: [uint<32>; 32];
    mem ram: [uint<32>; 256];
    inst dev = devices<CLKS_PER_BIT>();

    reg step: Step = .Fetch;
    reg pc: uint<32> = 0;
    reg instr: uint<32> init 0;
    reg rs1: uint<32> init 0;
    reg rs2: uint<32> init 0;
    reg result: uint<32> init 0; // the ALU's result: also the address of loads and stores
    reg jump: bool init false;
    reg word: uint<32> init 0;   // the word of the RAM a load reads
    let d = decode(instr);
    let offset = result[1:0];
    let to_device = is_device(result);

    dev.write = false;
    dev.uart_port = result[2];
    dev.wdata = rs2;

    match step {
        .Fetch => {
            instr := rom[pc[8:2]];
            step := .Decode;
        }
        .Decode => {
            rs1 := regs1[d.rs1];
            rs2 := regs2[d.rs2];
            step := .Execute;
        }
        .Execute => {
            let a = if d.a_pc { pc } else { rs1 };
            let b = if d.b_imm { d.imm } else { rs2 };
            result := alu(d.alu, a, b);
            jump := d.jal || d.jalr || (d.branch && branch_taken(d.funct3, rs1, rs2));
            step := .Memory;
        }
        .Memory => {
            if d.load { word := ram[result[9:2]]; }
            if d.store {
                if to_device {
                    dev.write = true;
                } else {
                    let lanes = store_lanes(d.funct3, rs2);
                    let mask = store_mask(d.funct3, offset);
                    for i in 0..4 {
                        if mask[i] { ram[result[9:2]][i * 8 + 7:i * 8] := lanes[i * 8 + 7:i * 8]; }
                    }
                }
            }
            step := .WriteBack;
        }
        .WriteBack => {
            let link = pc +% 4;
            let loaded = load_value(d.funct3, offset, if to_device { dev.rdata } else { word });
            let value = if d.jal || d.jalr { link } else if d.load { loaded } else { result };
            if d.writes {
                regs1[d.rd] := value;
                regs2[d.rd] := value;
            }
            pc := if !jump { link } else if d.jalr { (rs1 +% d.imm) & ~uint<32>(1) } else { pc +% d.imm };
            step := .Fetch;
        }
    }

    tx = dev.tx;
    led = dev.led;
}
