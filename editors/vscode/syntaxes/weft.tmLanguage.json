{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Weft",
  "scopeName": "source.weft",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#items" },
    { "include": "#declarations" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#domains" },
    { "include": "#calls" },
    { "include": "#variants" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.weft", "match": "///.*$" },
        { "name": "comment.line.double-slash.weft", "match": "//.*$" },
        { "name": "comment.block.weft", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "attributes": {
      "name": "meta.attribute.weft",
      "begin": "#\\[",
      "end": "\\]",
      "beginCaptures": { "0": { "name": "punctuation.definition.attribute.weft" } },
      "endCaptures": { "0": { "name": "punctuation.definition.attribute.weft" } },
      "patterns": [
        { "include": "#strings" },
        { "include": "#numbers" },
        { "name": "entity.name.function.attribute.weft", "match": "[A-Za-z_][A-Za-z0-9_]*" }
      ]
    },
    "items": {
      "patterns": [
        {
          "match": "\\b(extern\\s+)?(module)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.extern.weft" },
            "2": { "name": "keyword.declaration.module.weft" },
            "3": { "name": "entity.name.type.module.weft" }
          }
        },
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.weft" },
            "2": { "name": "entity.name.function.weft" }
          }
        },
        {
          "match": "\\b(struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.weft" },
            "2": { "name": "entity.name.type.weft" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(reg)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.reg.weft" },
            "2": { "name": "variable.other.register.weft" }
          }
        },
        {
          "match": "\\b(wire|let|var|const|mem|domain)\\s+(default\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.weft" },
            "2": { "name": "storage.modifier.weft" },
            "3": { "name": "variable.other.declaration.weft" }
          }
        },
        {
          "match": "\\b(inst)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*=\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.inst.weft" },
            "2": { "name": "variable.other.instance.weft" },
            "3": { "name": "entity.name.type.module.weft" }
          }
        },
        {
          "match": "\\b(in|out|inout)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*:",
          "captures": {
            "1": { "name": "storage.modifier.direction.weft" },
            "2": { "name": "variable.parameter.port.weft" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.weft",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.weft", "match": "\\\\." }]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.weft", "match": "\\b0[xX][0-9A-Fa-f_]+\\b" },
        { "name": "constant.numeric.binary.weft", "match": "\\b0[bB][01_?]+" },
        { "name": "constant.numeric.decimal.weft", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.weft", "match": "\\b(if|else|match|for|in)\\b" },
        { "name": "keyword.other.weft", "match": "\\b(module|extern|fn|struct|enum|type|init|default|async|assert)\\b" },
        { "name": "storage.type.weft", "match": "\\b(reg|wire|let|var|const|mem|inst|domain|out|inout)\\b" },
        { "name": "constant.language.weft", "match": "\\b(true|false|undef)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.weft", "match": "\\b(bool|uint|sint|index|clock|int|string)\\b" }
      ]
    },
    "domains": {
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.domain.weft" },
        "2": { "name": "entity.name.tag.domain.weft" }
      }
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b(concat|from_bits|unsafe_cross|hex_file|bin_file|clog2|bits_for|min|max|assert)\\s*(?=\\()",
          "captures": { "1": { "name": "support.function.builtin.weft" } }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=(<[^<>;{}]*>)?\\s*\\()",
          "captures": { "1": { "name": "entity.name.function.call.weft" } }
        }
      ]
    },
    "variants": {
      "match": "(?<![A-Za-z0-9_\\)\\]])\\.([A-Za-z_][A-Za-z0-9_]*)",
      "captures": { "1": { "name": "constant.other.enum-member.weft" } }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.assignment.next.weft", "match": ":=" },
        { "name": "keyword.operator.arithmetic.wrapping.weft", "match": "[+\\-*]%" },
        { "name": "keyword.operator.arrow.weft", "match": "=>|->" },
        { "name": "keyword.operator.comparison.weft", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.logical.weft", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.range.weft", "match": "\\.\\.=?" },
        { "name": "keyword.operator.weft", "match": "[+\\-*/%&|^~<>=]" }
      ]
    }
  }
}
